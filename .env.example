# Which LLM to use: "anthropic" or "ollama"
LLM_PROVIDER=ollama

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (https://ollama.com) - run `ollama pull qwen2.5:7b` first
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Where tasks are stored (docker compose sets /data/tasks.json)
TASKS_FILE=tasks.json

# Logging: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
